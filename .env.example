# ============================================================
# Environment Variables Template - Anjem Kuy
# ============================================================
# Copy this file to .env and fill in your actual values

# Firebase Configuration (REQUIRED)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Google Maps API (REQUIRED for Places Autocomplete)
# Get your API key at: https://console.cloud.google.com/google/maps-apis
# Enable: Places API, Maps JavaScript API
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mapbox Configuration (OPTIONAL - for enhanced address accuracy)
# Get your free token at: https://account.mapbox.com/access-tokens/
# 100k free requests/month
# REACT_APP_MAPBOX_TOKEN=pk.your-actual-mapbox-token-here

# Note: App will fallback to OpenStreetMap (Nominatim) if Mapbox token is not provided
